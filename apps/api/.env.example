# Postgres local (docker: npm run db:up) ou pooler do Supabase porta 6543 (transaction mode)
DATABASE_URL=postgres://hub:hub@localhost:5433/hub
# Só para migrations: mesmo banco. No Supabase, use o pooler porta 5432 (session mode).
DATABASE_URL_MIGRATE=postgres://hub:hub@localhost:5433/hub
# 32+ caracteres aleatórios: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-mais-de-32-caracteres
ALLOWED_ORIGINS=http://localhost:5173
# Em produção: hub.hungaralanches.com.br (o cookie vale para hub. e api.hub.)
COOKIE_DOMAIN=
NODE_ENV=development
